# ============================================================
# KontrolSehat .gitignore
# ============================================================

# ---------- RAHASIA DAN KUNCI (paling penting) ----------
# Konfigurasi kunci Supabase (dipakai lewat --dart-define-from-file)
env.json
env.*.json
*.env.json
.env
.env.*
*.env
secrets.json
secrets.*.json
config.local.*
supabase/

# Contoh konfigurasi tanpa kunci boleh di-commit
!env.example.json
!.env.example

# Keystore dan kunci tanda tangan Android
key.properties
**/key.properties
*.jks
*.keystore
*.pfx
*.p12
*.pem
*.key
*.der
*.crt

# Kredensial layanan lain (tidak dipakai, tapi dijaga sebagai pengaman)
google-services.json
GoogleService-Info.plist
service-account*.json
*credentials*.json
*.secret

# Catatan lokal berisi akun atau kunci
catatan-rahasia*
*.private.*

# ---------- FLUTTER DAN DART ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.fvm/
.fvmrc
build/
coverage/
pubspec_overrides.yaml
*.g.dart.bak
.metadata.bak

# Berkas hasil generate lokal
flutter_*.log
*.log
*.pid
*.pid.lock

# ---------- ANDROID ----------
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/
android/app/.cxx/
android/.cxx/
**/android/**/GeneratedPluginRegistrant.java
.gradle/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json

# ---------- iOS dan macOS (tidak dipakai, tetap diabaikan) ----------
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
ios/**/*.mode1v3
ios/**/*.mode2v3
ios/**/*.moved-aside
ios/**/*.pbxuser
ios/**/*.perspectivev3
ios/**/xcuserdata
**/DerivedData/
macos/Flutter/ephemeral/
*.ipa

# ---------- WEB, DESKTOP, DAN LAIN (tidak dipakai) ----------
.vercel/
.firebase/
node_modules/

# ---------- IDE DAN EDITOR ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.history/
.project
.classpath
.settings/
.metadata
*.swp
*.swo
*~

# ---------- SISTEM OPERASI ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- SUPABASE LOKAL ----------
supabase/.branches/
supabase/.temp/
supabase/.env
.supabase/

# ---------- DATA UJI DAN BERKAS SEMENTARA ----------
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/
*.sqlite
*.sqlite3
*.db
*.dump